# Shared editor policy for the code-wes-projects monorepo.
# https://editorconfig.org

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{dart,json,yaml,yml,md}]
indent_size = 2

[*.py]
indent_size = 4

[*.{sh,bash,zsh}]
indent_size = 2

[Makefile]
indent_style = tab
