{
  "name": "code-wes-projects",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "deploy:vercel": "node scripts/deploy-vercel.mjs",
    "build": "pnpm run build:proposal-email",
    "build:proposal-email": "pnpm --filter proposal-email build",
    "test:wesnest": "pnpm --filter wesnest-search test",
    "test:proposal-email": "pnpm --filter proposal-email test",
    "typecheck:proposal-email": "pnpm --filter proposal-email typecheck",
    "test": "pnpm run test:wesnest && pnpm run test:proposal-email"
  }
}